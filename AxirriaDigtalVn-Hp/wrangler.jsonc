// Cloudflare Worker: serves dist/ (output of `node build.js`) and the contact form API (worker.js).
// Secrets GAS_URL and GAS_TOKEN (Google Apps Script mailer) are set in the dashboard.
{
  "name": "axirriadigtalvn-hp",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
}
